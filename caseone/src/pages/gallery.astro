---
import Layout from '../layouts/Layout.astro';
import { getGallery, getStyles, type GalleryItem, type Style } from '../lib/wix';
import { optimizeImage } from '../lib/image';

// The 12 style slugs seeded by Task 4, in the order they should appear as
// filter chips when the "styles" CMS query is unavailable.
const CANONICAL_STYLE_SLUGS = [
	'cyberpunk',
	'minimal-luxury',
	'anime',
	'streetwear',
	'marble',
	'floral',
	'abstract',
	'graffiti',
	'vintage',
	'y2k',
	'futuristic',
	'photo-collage',
];

const FALLBACK_STYLE_LABELS: Record<string, string> = {
	cyberpunk: 'Cyberpunk',
	'minimal-luxury': 'Minimal Luxury',
	anime: 'Anime',
	streetwear: 'Streetwear',
	marble: 'Marble',
	floral: 'Floral',
	abstract: 'Abstract',
	graffiti: 'Graffiti',
	vintage: 'Vintage',
	y2k: 'Y2K',
	futuristic: 'Futuristic',
	'photo-collage': 'Photo Collage',
};

function truncatePrompt(text: string, max = 140): string {
	const trimmed = text.trim();
	if (trimmed.length <= max) return trimmed;
	return `${trimmed.slice(0, max - 1).trimEnd()}…`;
}

let styles: Style[] = [];
try {
	styles = await getStyles();
} catch (err) {
	console.error('[gallery] failed to load styles:', err);
	styles = [];
}

let allItems: GalleryItem[] = [];
try {
	allItems = await getGallery();
} catch (err) {
	console.error('[gallery] failed to load gallery items:', err);
	allItems = [];
}

// Chips come from the live "styles" collection when available; fall back to
// the canonical slug list (no accent color) so filtering still works if that
// query fails.
const chipStyles: Pick<Style, 'slug' | 'title' | 'accentColor'>[] =
	styles.length > 0
		? styles
		: CANONICAL_STYLE_SLUGS.map((slug) => ({
				slug,
				title: FALLBACK_STYLE_LABELS[slug] ?? slug,
				accentColor: '',
			}));

const styleBySlug = new Map(chipStyles.map((style) => [style.slug, style]));

const requestedStyleParam = Astro.url.searchParams.get('style');
const requestedStyle =
	requestedStyleParam && styleBySlug.has(requestedStyleParam) ? requestedStyleParam : 'all';

const visibleItems =
	requestedStyle === 'all' ? allItems : allItems.filter((item) => item.styleSlug === requestedStyle);

const emptyStateAllText = 'No designs in the gallery yet — be the first to share yours.';
const emptyStatePerStyleText = 'No designs in this style yet — be the first.';
---

<Layout
	title="Community Gallery — Caseone"
	description="Browse phone case designs shared by the Caseone community, filter by style, and remix any of them into your own."
>
	<section class="gallery-hero">
		<span class="eyebrow reveal">Community Gallery</span>
		<h1 class="display reveal">Made by you.</h1>
		<p class="gallery-intro reveal">
			Every design here started in the Studio and was shared by its creator. Filter by style,
			steal some inspiration, and remix anything you like.
		</p>
	</section>

	<section class="gallery-filters reveal" aria-label="Filter by style">
		<a
			href="/gallery"
			class:list={['style-chip', 'filter-chip', requestedStyle === 'all' && 'is-active']}
			data-style-chip="all"
		>
			All
		</a>
		{
			chipStyles.map((style) => (
				<a
					href={`/gallery?style=${encodeURIComponent(style.slug)}`}
					class:list={['style-chip', 'filter-chip', requestedStyle === style.slug && 'is-active']}
					data-style-chip={style.slug}
					style={style.accentColor ? `--chip-accent: ${style.accentColor}` : undefined}
				>
					{style.title}
				</a>
			))
		}
	</section>

	<section class="gallery-grid-section">
		<div class="gallery-grid" data-gallery-grid>
			{
				visibleItems.map((item) => {
					const style = styleBySlug.get(item.styleSlug);
					const label = style?.title ?? FALLBACK_STYLE_LABELS[item.styleSlug] ?? item.styleSlug;
					const accent = style?.accentColor || 'var(--coral)';
					const remixHref = `/studio?style=${encodeURIComponent(item.styleSlug)}&prompt=${encodeURIComponent(item.promptText)}`;

					return (
						<article class="gallery-card glass reveal" data-gallery-card data-style-slug={item.styleSlug}>
							<div class="gallery-card-media">
								<img
									src={optimizeImage(item.image, { width: 480, quality: 72 })}
									alt={`${item.title} phone case design by ${item.creatorName}`}
									loading="lazy"
									style="aspect-ratio: 4 / 5; object-fit: cover;"
								/>
							</div>
							<div class="gallery-card-body">
								<span class="style-chip" style={`--chip-accent: ${accent}`}>{label}</span>
								<h3 class="gallery-card-title">{item.title}</h3>
								<p class="gallery-card-creator">by {item.creatorName}</p>
							</div>
							<div class="gallery-card-hover-content">
								<p class="gallery-card-prompt">&ldquo;{truncatePrompt(item.promptText)}&rdquo;</p>
								<a class="btn-ghost gallery-card-remix" href={remixHref}>Remix this</a>
							</div>
						</article>
					);
				})
			}
		</div>

		<p
			class="gallery-empty-state"
			data-empty-state
			data-empty-all={emptyStateAllText}
			data-empty-style={emptyStatePerStyleText}
			hidden={visibleItems.length > 0}
		>
			{requestedStyle === 'all' ? emptyStateAllText : emptyStatePerStyleText}
		</p>
	</section>
</Layout>

<script>
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-card]'));
	const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-style-chip]'));
	const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

	function applyFilter(slug: string, updateHistory: boolean) {
		let visibleCount = 0;
		for (const card of cards) {
			const matches = slug === 'all' || card.dataset.styleSlug === slug;
			card.hidden = !matches;
			if (matches) visibleCount += 1;
		}

		for (const chip of chips) {
			chip.classList.toggle('is-active', chip.dataset.styleChip === slug);
		}

		if (emptyState) {
			emptyState.hidden = visibleCount !== 0;
			const text = slug === 'all' ? emptyState.dataset.emptyAll : emptyState.dataset.emptyStyle;
			if (text) emptyState.textContent = text;
		}

		if (updateHistory) {
			const url = new URL(window.location.href);
			if (slug === 'all') {
				url.searchParams.delete('style');
			} else {
				url.searchParams.set('style', slug);
			}
			history.replaceState(null, '', url);
		}
	}

	for (const chip of chips) {
		chip.addEventListener('click', (event) => {
			const slug = chip.dataset.styleChip;
			if (!slug) return;
			event.preventDefault();
			applyFilter(slug, true);
		});
	}

	const initialSlug = new URL(window.location.href).searchParams.get('style') || 'all';
	const knownSlugs = new Set(chips.map((chip) => chip.dataset.styleChip));
	applyFilter(knownSlugs.has(initialSlug) ? initialSlug : 'all', false);
</script>

<style>
	.gallery-hero {
		max-width: 42rem;
		margin: 0 auto;
		padding: clamp(3rem, 8vw, 5rem) clamp(1rem, 4vw, 2.5rem) 2rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.gallery-intro {
		font-size: 1.05rem;
		opacity: 0.75;
		max-width: 34rem;
	}

	.gallery-filters {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.6rem;
		padding: 0 clamp(1rem, 4vw, 2.5rem) 2.5rem;
	}

	@media (max-width: 720px) {
		.gallery-hero {
			padding-top: clamp(1.75rem, 6vw, 3rem);
			padding-bottom: 1.25rem;
			gap: 0.75rem;
		}

		.gallery-filters {
			flex-wrap: nowrap;
			justify-content: flex-start;
			overflow-x: auto;
			scroll-snap-type: x proximity;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			gap: 0.5rem;
			padding-bottom: 1.25rem;
			mask-image: linear-gradient(to right, #000 88%, transparent);
			-webkit-mask-image: linear-gradient(to right, #000 88%, transparent);
		}

		.gallery-filters::-webkit-scrollbar {
			display: none;
		}

		.filter-chip {
			flex: 0 0 auto;
			scroll-snap-align: start;
		}

		.gallery-grid {
			grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
			gap: 1rem;
		}
	}

	.filter-chip {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		padding: 0.5rem 1.1rem;
		font-size: 0.85rem;
		font-weight: 500;
		border: 1px solid rgba(243, 239, 255, 0.15);
		background: transparent;
		transition: border-color 0.15s cubic-bezier(0.22, 1, 0.36, 1), background 0.15s cubic-bezier(0.22, 1, 0.36, 1), color 0.15s cubic-bezier(0.22, 1, 0.36, 1);
		cursor: pointer;
	}

	.filter-chip:hover {
		border-color: var(--chip-accent, var(--coral));
	}

	.filter-chip.is-active {
		background: var(--chip-accent, var(--ink));
		border-color: var(--chip-accent, var(--ink));
		color: #fff;
	}

	.gallery-grid-section {
		padding: 0 clamp(1rem, 4vw, 2.5rem) clamp(3rem, 8vw, 5rem);
		max-width: 84rem;
		margin: 0 auto;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 1.5rem;
	}

	.gallery-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		padding: 0;
		position: relative;
	}

	.gallery-card-media {
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius) var(--radius) 0 0;
	}

	.gallery-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery-card-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		position: relative;
		z-index: 2;
	}

	.style-chip {
		display: inline-flex;
		align-self: flex-start;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		color: var(--chip-accent, var(--coral));
		background: color-mix(in srgb, var(--chip-accent, var(--coral)) 14%, transparent);
	}

	.gallery-card-title {
		font-size: 1.1rem;
	}

	.gallery-card-creator {
		font-size: 0.85rem;
		opacity: 0.65;
	}

	.gallery-card-hover-content {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 1.25rem;
		background: linear-gradient(to top, rgba(18, 16, 26, 0.95) 0%, rgba(18, 16, 26, 0.8) 70%, transparent 100%);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		transform: translateY(100%);
		opacity: 0;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		z-index: 3;
	}

	.gallery-card:hover .gallery-card-hover-content,
	.gallery-card:focus-within .gallery-card-hover-content {
		transform: translateY(0);
		opacity: 1;
	}

	.gallery-card-prompt {
		font-size: 0.9rem;
		opacity: 0.9;
		line-height: 1.4;
		color: #fff;
	}

	.gallery-card-remix {
		align-self: flex-start;
		margin-top: 0.25rem;
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.2);
	}
	
	.gallery-card-remix:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	.gallery-empty-state {
		text-align: center;
		padding: 3rem 1rem;
		opacity: 0.65;
		font-size: 1rem;
	}

	/* Conversion pass */

	.gallery-card {
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 28px -10px rgba(0, 0, 0, 0.45);
	}

	.gallery-card-media img {
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gallery-card:hover .gallery-card-media img {
		transform: scale(1.05);
	}
</style>
