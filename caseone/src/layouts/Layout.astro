---
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GenesisIntro from '../components/GenesisIntro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	/** Show the genesis loading intro (home only by default). */
	showIntro?: boolean;
	/** Design image revealed on the intro case back. */
	introDesignUrl?: string;
}

const { title, description, image = '/og-image.png', showIntro = false, introDesignUrl } = Astro.props;
// Prefer Astro.site when set; otherwise force https on the request origin so
// canonical/og URLs never ship as http:// on the public host.
const siteOrigin = (() => {
	if (Astro.site) return Astro.site;
	const origin = new URL(Astro.url.origin);
	origin.protocol = 'https:';
	return origin;
})();
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = new URL(image, siteOrigin).href;
const finalIntroDesignUrl = introDesignUrl ? new URL(introDesignUrl, siteOrigin).href : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CASEONE" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<ViewTransitions />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		{showIntro && <GenesisIntro designUrl={finalIntroDesignUrl} client:only="react" />}
		<div class="announcement-bar" data-announcement>
			<p class="announcement-text" data-announcement-text>Free shipping on orders over $75</p>
		</div>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
		<script>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!prefersReducedMotion) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('in');
								observer.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
				);

				document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

				// Manual sweep — the observer can subscribe while the document is
				// still hidden/pre-render (e.g. a webview that mounts hidden), in
				// which case its initial records report not-intersecting even for
				// elements already inside the viewport, and nothing re-triggers for
				// them afterward since there's no scroll to fire a new observation.
				// This force-reveals anything already in view; idempotent, since it
				// skips elements already marked `.in`.
				const sweepReveal = () => {
					document.querySelectorAll('.reveal:not(.in)').forEach((el) => {
						const rect = el.getBoundingClientRect();
						if (rect.top < window.innerHeight && rect.bottom > 0) {
							el.classList.add('in');
							observer.unobserve(el);
						}
					});
				};

				sweepReveal();
				document.addEventListener('visibilitychange', () => {
					if (document.visibilityState === 'visible') sweepReveal();
				});
				window.addEventListener('load', sweepReveal);
				document.addEventListener('astro:page-load', sweepReveal);
			}

			// Announcement bar rotation — the first message is already in the
			// server-rendered markup above, so reduced-motion users (and the
			// pre-hydration paint for everyone else) just see that one message
			// and nothing more happens.
			if (!prefersReducedMotion) {
				const messages = [
					'Free shipping on orders over $75',
					'Made to order — ships in 5–7 days',
					'★ 4.9 from 12,000+ makers',
				];
				const textEl = document.querySelector('[data-announcement-text]');
				if (textEl) {
					let messageIndex = 0;
					setInterval(() => {
						messageIndex = (messageIndex + 1) % messages.length;
						textEl.classList.add('is-fading');
						setTimeout(() => {
							textEl.textContent = messages[messageIndex];
							textEl.classList.remove('is-fading');
						}, 250);
					}, 4000);
				}
			}
		</script>
	</body>
</html>

<style>
	.announcement-bar {
		background: linear-gradient(90deg, #1a0a14 0%, #12081c 50%, #0a0a16 100%);
		color: var(--ink);
		border-bottom: 1px solid var(--line);
		text-align: center;
		padding: 0.5rem 1rem;
	}

	.announcement-text {
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		opacity: 1;
		transition: opacity 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.announcement-text.is-fading {
		opacity: 0;
	}
</style>
